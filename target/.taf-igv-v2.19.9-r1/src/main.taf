<taf-app:container:ghcr.io/taffish/igv:2.19.9-r1$@[docker/podman: --init $(taf_kauto="${TAFFISH_IGV_RESOURCE_AUTO_MOUNT:-1}"; taf_kroot=""; if test "$taf_kauto" = 0; then exit 0; elif test "$taf_kauto" != 1; then printf >&2 'taf-igv: RESOURCE_AUTO_MOUNT accepts only 0 or 1\n'; printf -- '--taffish-igv-invalid-root'; exit 0; fi; if test "${TAFFISH_IGV_RESOURCE_PATH+x}" = x; then taf_kroot="${TAFFISH_IGV_RESOURCE_PATH}"; if test -z "$taf_kroot"; then printf >&2 'taf-igv: explicit RESOURCE_PATH is empty\n'; printf -- '--taffish-igv-invalid-root'; exit 0; fi; else for taf_kcandidate in "${HOME}/.local/share/taffish/resources/igv" /usr/local/share/taffish/resources/igv /opt/taffish/resources/igv; do if test -e "$taf_kcandidate" || test -L "$taf_kcandidate"; then taf_kroot="$taf_kcandidate"; break; fi; done; fi; if test -n "$taf_kroot"; then if test "$(printf '%s' "$taf_kroot" | tr -d ' \011\012\013\014\015\052\054\072\077\133\135')" != "$taf_kroot"; then printf >&2 'taf-igv: automatic mount path contains whitespace, comma, colon, or glob characters; use documented manual bind\n'; printf -- '--taffish-igv-invalid-root'; exit 0; fi; taf_kroot="$(cd "$taf_kroot" 2>/dev/null && { pwd -P; printf X; })"; taf_kroot="${taf_kroot%X}"; taf_kroot="${taf_kroot%?}"; if test -z "$taf_kroot" || test "$taf_kroot" = / || test ! -d "$taf_kroot" || test "$(printf '%s' "$taf_kroot" | tr -d ' \011\012\013\014\015\052\054\072\077\133\135')" != "$taf_kroot"; then printf >&2 'taf-igv: database root is missing, invalid, or unsafe\n'; printf -- '--taffish-igv-invalid-root'; else printf -- '--volume=%s:/igv-resources:ro --env=TAFFISH_IGV_RESOURCE_ACTIVE=1' "$taf_kroot"; fi; fi)][apptainer: $(taf_kauto="${TAFFISH_IGV_RESOURCE_AUTO_MOUNT:-1}"; taf_kroot=""; if test "$taf_kauto" = 0; then exit 0; elif test "$taf_kauto" != 1; then printf >&2 'taf-igv: RESOURCE_AUTO_MOUNT accepts only 0 or 1\n'; printf -- '--taffish-igv-invalid-root'; exit 0; fi; if test "${TAFFISH_IGV_RESOURCE_PATH+x}" = x; then taf_kroot="${TAFFISH_IGV_RESOURCE_PATH}"; if test -z "$taf_kroot"; then printf >&2 'taf-igv: explicit RESOURCE_PATH is empty\n'; printf -- '--taffish-igv-invalid-root'; exit 0; fi; else for taf_kcandidate in "${HOME}/.local/share/taffish/resources/igv" /usr/local/share/taffish/resources/igv /opt/taffish/resources/igv; do if test -e "$taf_kcandidate" || test -L "$taf_kcandidate"; then taf_kroot="$taf_kcandidate"; break; fi; done; fi; if test -n "$taf_kroot"; then if test "$(printf '%s' "$taf_kroot" | tr -d ' \011\012\013\014\015\052\054\072\077\133\135')" != "$taf_kroot"; then printf >&2 'taf-igv: automatic mount path contains whitespace, comma, colon, or glob characters; use documented manual bind\n'; printf -- '--taffish-igv-invalid-root'; exit 0; fi; taf_kroot="$(cd "$taf_kroot" 2>/dev/null && { pwd -P; printf X; })"; taf_kroot="${taf_kroot%X}"; taf_kroot="${taf_kroot%?}"; if test -z "$taf_kroot" || test "$taf_kroot" = / || test ! -d "$taf_kroot" || test "$(printf '%s' "$taf_kroot" | tr -d ' \011\012\013\014\015\052\054\072\077\133\135')" != "$taf_kroot"; then printf >&2 'taf-igv: database root is missing, invalid, or unsafe\n'; printf -- '--taffish-igv-invalid-root'; else printf -- '--bind=%s:/igv-resources:ro --env=TAFFISH_IGV_RESOURCE_ACTIVE=1' "$taf_kroot"; fi; fi)]>
igv ::*ARGV*::
